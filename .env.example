# =====================================================================
# Rudra Pahune Portfolio - Environment Configuration Template
# =====================================================================
# Copy this file to .env.local for local development.
# In Vercel, add these variables in: Project Settings -> Environment Variables.
# NEVER commit your real secrets (.env.local) to version control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI ASSISTANT (Google Gemini API)
# ---------------------------------------------------------------------
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# If left empty, the assistant seamlessly falls back to a curated multi-intent knowledge engine.
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# 2. CONTACT FORM EMAIL DELIVERY (Resend)
# ---------------------------------------------------------------------
# Obtain an API key at: https://resend.com
# Free tier provides 3,000 emails/month (100 emails/day).
RESEND_API_KEY=

# Verified sender email address in Resend.
# For testing without a custom domain, use: "Portfolio Contact <onboarding@resend.dev>"
# Once your custom domain is verified in Resend (DNS records), use: "Rudra Pahune <contact@rudrapahune.dev>"
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Where contact form messages should be delivered (defaults to rudrapahune@gmail.com if unset)
CONTACT_RECIPIENT_EMAIL=rudrapahune@gmail.com

# ---------------------------------------------------------------------
# 3. GITHUB API RATE LIMITING (Optional)
# ---------------------------------------------------------------------
# A GitHub Personal Access Token (classic or fine-grained with public read-only access).
# Without a token, GitHub REST API allows 60 req/hr per IP (cached via Next.js ISR for 30 min).
# Adding a token increases this to 5,000 req/hr.
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ---------------------------------------------------------------------
# 4. DISTRIBUTED SERVERLESS RATE LIMITING (Optional - Upstash Redis)
# ---------------------------------------------------------------------
# For global distributed rate limiting across all Vercel edge/serverless lambdas.
# Obtain a free Redis database at: https://console.upstash.com
# If omitted, the application uses an in-memory sliding-window limiter on each instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
